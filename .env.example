# DeepSeek subtitle translation
# Copy this file to .env and fill API_KEY. The backend loads .env silently at startup.
API_KEY=
MODEL=deepseek-v4-pro
PROVIDER=deepseek
THINK_LEVEL=max

# Optional Web runtime overrides
WEB_HOST=127.0.0.1
WEB_PORT=7860

# Optional LADA overrides
LADA_CLI_PATH=D:\lada\lada-cli.exe
LADA_OUTPUT_DIR=./output/lada