# DeepSeek subtitle translation
# Copy this file to .env and fill API_KEY. The backend loads .env silently at startup.
API_KEY=
MODEL=deepseek-v4-pro
PROVIDER=deepseek
THINK_LEVEL=max
DEEPSEEK_MAX_SRT_SIZE_MB=20

# Optional Web runtime overrides
WEB_HOST=127.0.0.1
WEB_PORT=7860
WEB_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
WEB_WARMUP_ON_STARTUP=1
WEB_WARMUP_VAD=1
WEB_WARMUP_ASR=1

# Optional LADA overrides
LADA_CLI_PATH=D:\lada\lada-cli.exe
LADA_OUTPUT_DIR=./output/lada